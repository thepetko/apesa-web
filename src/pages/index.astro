---
const target = `${import.meta.env.BASE_URL}navrhy/a/`;
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>APESA — návrhy nového webu</title>
  </head>
  <body>
    <h1>Návrhy nového webu APESA</h1>
    <p><a href={target}>Otvoriť návrh A — Blízko praxe</a></p>
    <p><a href={`${import.meta.env.BASE_URL}navrhy/b/`}>Otvoriť návrh B — Priestor pre učenie</a></p>
  </body>
</html>
