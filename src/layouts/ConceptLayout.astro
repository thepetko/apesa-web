---
import '../styles/global.css';
import '../styles/concepts.css';
import { concepts, type Concept } from '../data/concepts';
interface Props { variant: Concept; }
const { variant } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={concepts[variant].description} />
    <meta name="theme-color" content="#0048BC" />
    <title>{`APESA — návrh ${variant.toUpperCase()} · ${concepts[variant].name}`}</title>
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="preload" href={`${base}fonts/nunito-800.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['concept', `concept-${variant}`]}>
    <a class="skip-link" href="#hlavny-obsah">Preskočiť na obsah</a>
    <aside class="concept-switch" aria-label="Porovnanie dizajnov">
      <div class="concept-shell switch-inner">
        <span>Pracovné návrhy APESA</span>
        <nav aria-label="Vybrať návrh">
          <a href={`${base}navrhy/a/`} aria-current={variant === 'a' ? 'page' : undefined}>A <span>Blízko praxe</span></a>
          <a href={`${base}navrhy/b/`} aria-current={variant === 'b' ? 'page' : undefined}>B <span>Priestor pre učenie</span></a>
        </nav>
      </div>
    </aside>
    <slot />
  </body>
</html>
